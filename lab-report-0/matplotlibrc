# matplotlibrc - LaTeX-style configuration for physics lab reports
# Place this file in your project directory or ~/.matplotlib/

# Use LaTeX for text rendering
text.usetex : True
text.latex.preamble : \usepackage{lmodern} \usepackage{amsmath} \usepackage{amssymb}

# Font settings - Latin Modern to match LaTeX
font.family : serif
font.serif : Latin Modern Roman, Computer Modern Roman, DejaVu Serif
font.sans-serif : Latin Modern Sans, Computer Modern Sans Serif, DejaVu Sans
font.monospace : Latin Modern Mono, Computer Modern Typewriter, DejaVu Sans Mono
mathtext.fontset : cm

# Font sizes
font.size : 11
axes.labelsize : 11
axes.titlesize : 12
xtick.labelsize : 10
ytick.labelsize : 10
legend.fontsize : 10
figure.titlesize : 12

# Figure settings
figure.figsize : 6, 4.5
figure.dpi : 150
savefig.dpi : 300
savefig.bbox : tight
savefig.pad_inches : 0.1

# Axes settings
axes.linewidth : 0.8
axes.grid : False
axes.axisbelow : True
axes.labelpad : 4.0
axes.formatter.use_mathtext : True
axes.formatter.limits : -3, 3

# Grid settings
grid.alpha : 0.3
grid.linewidth : 0.5
grid.linestyle : --

# Line settings
lines.linewidth : 1.5
lines.markersize : 8
lines.markeredgewidth : 1.5

# Legend settings
legend.frameon : True
legend.framealpha : 0.9
legend.fancybox : False
legend.edgecolor : black
legend.shadow : False

# Tick settings
xtick.direction : in
ytick.direction : in
xtick.major.width : 0.8
ytick.major.width : 0.8
xtick.minor.width : 0.6
ytick.minor.width : 0.6
xtick.major.size : 4
ytick.major.size : 4
xtick.minor.size : 2.5
ytick.minor.size : 2.5

# Error bar settings
errorbar.capsize : 3

# Color cycle - professional colors
axes.prop_cycle : cycler('color', ['1f77b4', 'ff7f0e', '2ca02c', 'd62728', '9467bd', '8c564b', 'e377c2', '7f7f7f', 'bcbd22', '17becf'])
